# Local Compose environment. Copy to .env and fill in real values.
# NEVER commit a real .env; every password below must be replaced before running.

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_APP_PASSWORD=replace-with-strong-app-password
MYSQL_DATABASE=app

# First administrator bootstrap (used only by the local profile)
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password
